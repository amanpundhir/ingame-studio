# Copy to .env and fill in. Never commit .env.
# Base endpoint of your Azure AI Foundry / Azure OpenAI resource (no path).
AZURE_OPENAI_ENDPOINT=https://<your-resource>.services.ai.azure.com
AZURE_OPENAI_API_KEY=<your-key>
AZURE_OPENAI_DEPLOYMENT=<your-deployment-name>
AZURE_OPENAI_API_VERSION=2024-10-21
# Optional: set to "off" to force the local deterministic engine (used by tests).
# INGAME_LLM=off
# Optional: location of the persisted narrative cache.
# NARRATIVE_CACHE_FILE=data/narrative_cache.json

# Optional: Azure Cosmos DB for NoSQL as the shared narrative store (database "ingame", container "narratives").
# COSMOS_ENDPOINT=https://<your-account>.documents.azure.com:443/
# COSMOS_KEY=<your-key>
# Optional: INGAME_COSMOS=off ignores the Cosmos credentials; INGAME_ORCHESTRATION=plain turns Agent Framework off.
